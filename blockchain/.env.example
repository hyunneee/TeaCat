# ═════════════════════════════════════════════════════════════
#  티캣 블록체인 서비스 — 환경변수 설명
#
#  이 파일은 **설명서입니다. 값이 들어있지 않습니다.**
#  키 형태의 값은 커밋되는 파일에 절대 두지 않습니다 — 공개 테스트 키라도
#  그 자리에 진짜 키를 넣는 사람이 반드시 생깁니다.
#
#  실제 값이 담긴 .env 는 아래 명령이 만들어줍니다. (.env 는 커밋되지 않습니다)
#
#      npm run setup:env
#
#  니모닉·오퍼레이터 키·내부 API 키를 **무작위로 생성**해서 .env 에 씁니다.
#  로컬 체인(`npm run chain`)은 그 니모닉으로 계정을 만들고 자금을 채웁니다.
#
#  변수를 추가하면 이 파일에 설명도 함께 적어주세요.
#  설명 없는 줄은 다음 사람이 손대지 못합니다.
# ═════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────
#  NODE_ENV — 실행 모드
#
#  값     : development | test | production
#  읽는 곳: api
#  기본값 : development
# ───────────────────────────────────────────────────────────────
NODE_ENV=


# ───────────────────────────────────────────────────────────────
#  PORT — Express 가 열 포트
#
#  읽는 곳: api
#  기본값 : 4000
#  참고   : Spring 이 이 포트로 붙습니다. 바꾸면 Spring 설정도 같이 바꿔야 합니다.
# ───────────────────────────────────────────────────────────────
PORT=


# ───────────────────────────────────────────────────────────────
#  HOST — Express 가 붙을 주소
#
#  값     : 기본 127.0.0.1
#  읽는 곳: api
#  왜     : 이 프로세스는 오퍼레이터 개인키와 마스터 니모닉을 쥐고 있습니다.
#           실수로 사설망·공인 IP 에 열리면 안 되므로 기본을 루프백으로 둡니다.
#  넓힐 때: 컨테이너처럼 밖에서 붙어야 하면 0.0.0.0. 그때도 앞단에서 막으세요.
# ───────────────────────────────────────────────────────────────
HOST=


# ───────────────────────────────────────────────────────────────
#  CHAIN_ID — 붙을 체인의 식별자
#
#  값     : 31221 SSAFY 체인(기본) · 31337 로컬 Hardhat
#  읽는 곳: api
#  틀리면 : 실제 체인과 다르면 ethers 가 "network changed" 로 모든 요청을 거부합니다.
#           /health 의 warnings 가 어느 쪽이 틀렸는지 알려줍니다.
#           틀린 채로 도는 것보다 낫습니다 — 엉뚱한 체인에 서명하게 되니까요.
#  참고   : 지갑 주소가 체인마다 달라지는 이유는 DESIGN.md 5-3.
# ───────────────────────────────────────────────────────────────
CHAIN_ID=


# ───────────────────────────────────────────────────────────────
#  RPC_URL — 체인에 말을 거는 주소
#
#  값     : SSAFY 체인이면 https://rpc.ssafy-blockchain.com
#           로컬 체인이면 http://127.0.0.1:8545
#  읽는 곳: api, Hardhat(ssafy 네트워크)
#  틀리면 : /health 의 chain.connected 가 false 가 됩니다.
#
#  SSAFY 체인에 대해 알아둘 것 (직접 노드에 물어본 값입니다)
#    - 가스 무료   gasPrice 가 0 입니다. 오퍼레이터 잔고가 0 이어도 트랜잭션이 나갑니다.
#    - 블록 10초   로컬처럼 즉시 확정되지 않습니다. "보내고 바로 읽기" 는 깨집니다.
#    - EVM 은 Constantinople  PUSH0·CHAINID·BASEFEE 가 없습니다.
#                 컴파일 타깃을 올리면 배포가 실패합니다 — hardhat.config.ts 참고.
#    - 공용       팀·다른 교육생과 같이 씁니다. 내가 지운 게 남에게도 지워집니다.
# ───────────────────────────────────────────────────────────────
RPC_URL=


# ───────────────────────────────────────────────────────────────
#  TX_SENDER — 트랜잭션을 어떤 방식으로 보낼지 (DESIGN.md 5-2)
#
#  값 :
#    relayer      오퍼레이터 EOA 가 직접 전송              ← M1 (지금)
#    direct-4337  UserOp 를 EntryPoint 에 직접 handleOps   ← M4, 번들러 없이
#    bundler      표준 eth_sendUserOperation               ← M5
#
#  읽는 곳: api
#  왜 있나: 4337 을 붙였다가 문제가 생기면 relayer 로 되돌려 원인을 가릅니다.
#           relayer 로도 실패하면 컨트랙트/서버 로직, relayer 로는 되면 원인은 4337.
#           services/ 코드는 셋 다 동일합니다.
# ───────────────────────────────────────────────────────────────
TX_SENDER=


# ───────────────────────────────────────────────────────────────
#  SLOW_CHAIN — 로컬 체인을 일부러 느리게
#
#  값     : true | false
#  읽는 곳: Hardhat (`npm run chain:slow` 가 true 로 켭니다)
#  무엇   : true 면 10초마다 블록을 만들어 SSAFY 체인과 같은 속도가 됩니다.
#  왜     : 로컬은 즉시 확정돼서 "보내고 바로 읽기" 같은 코드가 통과해버립니다.
#           SSAFY 체인(10초)에서는 무너집니다. 통합 테스트 때 켜서 미리 잡습니다. (DESIGN.md 8장)
#  참고   : SSAFY 체인에 직접 붙어 있다면 이 값은 아무 영향이 없습니다.
# ───────────────────────────────────────────────────────────────
SLOW_CHAIN=


# ───────────────────────────────────────────────────────────────
#  MASTER_MNEMONIC — 유저 지갑을 파생하는 마스터 키 (DESIGN.md 5-1)
#
#  값     : BIP-39 니모닉 12~24 단어
#  얻는 법: npm run setup:env 가 무작위로 만들어 넣습니다
#  읽는 곳: api. 로컬 체인은 이 니모닉으로 계정을 만들어 자금을 채웁니다
#           (테스트넷·운영에서는 Hardhat 이 읽지 않습니다)
#  무엇   : 유저 개인키는 어디에도 저장하지 않고, 이 니모닉 + 파생 인덱스로
#           매번 다시 만듭니다. Spring DB 가 통째로 유출돼도 이게 없으면 주소 목록일 뿐입니다.
#
#  주의   : 유출 = 전 유저 자산 유출. 바꾸면 전 유저 주소가 바뀝니다 (= 이관, DESIGN.md 5-4).
# ───────────────────────────────────────────────────────────────
MASTER_MNEMONIC=


# ───────────────────────────────────────────────────────────────
#  USER_ACCOUNT_PATH — 유저 지갑 파생 경로의 접두사
#
#  값     : BIP-44 경로. 뒤에 /{derivationIndex} 가 붙습니다 → m/44'/60'/1'/0/42
#  기본값 : m/44'/60'/1'/0
#  읽는 곳: api
#  왜 1'  : 오퍼레이터(m/44'/60'/0'/…)와 account 레벨에서 분리합니다.
#           같은 공간을 쓰면 언젠가 인덱스가 겹칩니다.
#
#  주의   : 한 번 정하면 바꾸지 마세요. 경로가 바뀌면 모든 유저의 주소가 바뀌고,
#           이미 발행된 티켓·토큰은 옛 주소에 그대로 남습니다.
# ───────────────────────────────────────────────────────────────
USER_ACCOUNT_PATH=


# ───────────────────────────────────────────────────────────────
#  OPERATOR_PRIVATE_KEY — 트랜잭션을 보내는 지갑 (**팀 공용**)
#
#  값     : 0x + 64자리 hex
#  읽는 곳: api + Hardhat 배포 스크립트
#  무엇   : M1 에서는 이 계정이 모든 트랜잭션을 직접 보냅니다.
#  잔고   : SSAFY 체인은 가스가 무료라 채워둘 필요가 없습니다. 0 이어도 정상입니다.
#
#  ★ 이 키는 팀이 하나를 공유합니다. 니모닉과 달리 개인 값이 아닙니다.
#
#    왜: 공용 체인에서는 **배포한 계정이 그 컨트랙트의 admin** 입니다.
#        각자 다른 키를 쓰면 남이 배포한 컨트랙트의 onlyOwner 함수가 막힙니다.
#        키를 맞춰두면 팀 누구나 같은 컨트랙트를 운영할 수 있습니다.
#
#    얻는 법: 팀에서 받아 이 자리에 붙여넣습니다. **git 밖으로 전달하세요.**
#             setup:env 는 일단 개인 키를 넣어둡니다 — 그대로 두면 배포는 되지만
#             팀이 배포한 컨트랙트의 admin 함수는 호출할 수 없습니다.
#             /health 가 이 불일치를 경고합니다.
#
#    로컬 체인: 공용 키는 로컬 노드의 니모닉 계정에 없어 잔고가 0 입니다.
#               npm run chain:reset 이 알아서 채워주므로 신경 쓰지 않아도 됩니다.
# ───────────────────────────────────────────────────────────────
OPERATOR_PRIVATE_KEY=


# ───────────────────────────────────────────────────────────────
#  CONTRACT_OPERATOR_PRIVATE_KEY — OPERATOR_ROLE 을 쥔 지갑 (선택)
#
#  값     : 0x + 64자리 hex
#  읽는 곳: api
#  무엇   : 도안 등록 · 정지 스위치 · 추첨(열기·공개·취소)을 서명합니다.
#           위 OPERATOR_PRIVATE_KEY 는 **발행(MINTER_ROLE)** 키라 서로 다릅니다.
#
#  ★ 배포 스크립트의 CONTRACT_OPERATOR_ADDRESS 와 **짝**입니다.
#    그 주소에 OPERATOR_ROLE 이 부여되므로 여기에는 그 주소의 개인키를 넣습니다.
#    어긋나면 도안 등록과 추첨이 전부 AccessControlUnauthorizedAccount 로 실패합니다.
#
#  비워두면: OPERATOR_PRIVATE_KEY 로 떨어집니다. 역할을 나누지 않은 개발 환경의
#            기존 동작 그대로라 지금 돌아가는 것이 깨지지 않습니다.
#
#  왜 필요한가: 추첨 공개에는 **약 42분 시한**이 있습니다(블록해시 256개).
#               사람이 수동으로 처리할 수 없어 API 가 직접 서명해야 합니다.
# ───────────────────────────────────────────────────────────────
CONTRACT_OPERATOR_PRIVATE_KEY=


# ───────────────────────────────────────────────────────────────
#  DRAW_SEED_SECRET — 추첨 시드를 파생하는 비밀 (선택)
#
#  값     : 32자 이상의 임의 문자열
#  읽는 곳: api
#  무엇   : seed = keccak256(keccak256(DRAW_SEED_SECRET), drawId)
#
#  ★ 시드를 저장하지 않기 위한 값입니다. 니모닉과 같은 원리로, 재시작해도 같은
#    시드가 나와서 커밋과 리빌 사이에 상태를 들고 있지 않아도 됩니다.
#
#  주의   : 이 값이 새면 **리빌 전에 결과를 미리 아는 사람**이 생깁니다.
#           결과를 바꾸지는 못하지만(블록해시가 남아 있습니다) 공정성 문제는 됩니다.
#           니모닉과 같은 급으로 다루세요. 개인 값이라 팀과 맞출 필요가 없습니다.
#
#  비워두면: 서버는 뜨지만 추첨 경로가 돌지 않습니다.
# ───────────────────────────────────────────────────────────────
DRAW_SEED_SECRET=


# ───────────────────────────────────────────────────────────────
#  INTERNAL_API_KEY — Spring ↔ 이 서비스 사이의 S2S 인증 (DESIGN.md 1장)
#
#  값     : 16자 이상 문자열
#  얻는 법: npm run setup:env 가 무작위로 만들어 넣습니다
#  읽는 곳: api
#  쓰는 법: Spring 이 /internal/** 호출 시 x-internal-key 헤더로 보냅니다
#  왜     : 이 프로세스는 오퍼레이터 개인키와 마스터 니모닉을 쥐고 있습니다.
#           브라우저에서 직접 닿는 경로가 하나라도 있으면 안 됩니다.
#  틀리면 : 401 UNAUTHORIZED
# ───────────────────────────────────────────────────────────────
INTERNAL_API_KEY=


# ───────────────────────────────────────────────────────────────
#  DATABASE_URL
#  값     : postgres://user:pass@host:5432/teacat
#  읽는 곳: api
#  왜     : 블록 확정을 Spring 대신 우리가 기다려서 tickets 행을 갱신합니다.
#           결제 직후 발행이 유저에게 실패로 보이면 안 된다는 요구 때문입니다.
#           (DESIGN.md 1장 "예외 하나")
#
#  주의   : **우리 DB 가 아닙니다.** 스키마 주인은 Spring/Hibernate 이고
#           우리는 transfer_status·token_id·mint_tx_hash·burn_tx_hash 만 씁니다.
#           그 컬럼만 UPDATE 되는 전용 계정을 쓰세요.
#
#  없으면 : 서버는 뜨지만 확정 기록이 꺼집니다. 체인만으로 개발할 때는 그래도
#           됩니다. 운영에서 빠뜨리면 티켓이 영원히 PENDING 이라 /health 가 경고합니다.
#  틀리면 : 기동할 때 스키마를 확인해서, 컬럼이 없으면 그 자리에서 죽습니다
# ───────────────────────────────────────────────────────────────
DATABASE_URL=


# ═══ 배포할 때만 쓰는 것 (api 는 안 읽습니다) ══════════════════
#
#  CONTRACT_ADMIN_ADDRESS
#    DEFAULT_ADMIN_ROLE 을 받을 주소. 권한을 주고 뺏는 키입니다.
#    **API 프로세스에 올리지 마세요.** 없으면 배포 계정이 되고 경고가 뜹니다.
#    admin 과 minter 가 같으면 그 키 하나로 무제한 발행 + 권한 조작이 가능합니다.
#
#  CONTRACT_OPERATOR_ADDRESS
#    OPERATOR_ROLE 을 받을 주소. 없으면 admin 과 같아집니다.
#    CatMoney 에서는 정지·해제만이지만, TicketSBT 에서는 **소각(예매 취소)**도
#    이 역할입니다 — api 가 그 키로 서명하므로 오퍼레이터와 같아야 합니다.
#
#    minter(발행)는 항상 배포 계정입니다 — api 가 그 키로 서명하기 때문입니다.
#
#  TICKET_ADMIN_ADDRESS · TICKET_OPERATOR_ADDRESS
#  CATMONEY_ADMIN_ADDRESS · CATMONEY_OPERATOR_ADDRESS
#    컨트랙트별로 다르게 주고 싶을 때만. 없으면 위의 공용 값을 씁니다.
#
#  FORCE_REDEPLOY=true
#    **평소에는 쓰지 마세요.** 기본 동작은 "이미 배포된 것은 건너뛰고 없는 것만
#    배포" 라서, 컨트랙트를 새로 추가할 때는 아무것도 안 붙여도 됩니다.
#    이 값을 켜면 이미 있는 것까지 전부 새 주소로 다시 배포하고, 옛 컨트랙트의
#    캣머니 잔액과 발행된 티켓은 되찾을 수 없습니다.
#
# ═══════════════════════════════════════════════════════════════


# ═══ 아직 안 쓰는 것 ═══════════════════════════════════════════
#
#  ENTRY_POINT_ADDRESS  ERC-4337 EntryPoint 주소 (M4).
#
#    주의: SSAFY 체인에는 EntryPoint 를 올릴 수 없습니다.
#    EntryPoint 는 UserOp 해시에 `block.chainid` 를 쓰는데, 이 체인의 EVM 은
#    Constantinople 이라 CHAINID 옵코드 자체가 없습니다. 컴파일 단계에서 막힙니다.
#    M4 로 가려면 다른 체인이 필요합니다. (DESIGN.md 9장)
# ═══════════════════════════════════════════════════════════════
