{
  "name": "@teacat/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "티캣 온체인 컨트랙트 (Hardhat) — ABI·주소·타입을 api 로 export",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prepare": "hardhat compile",
    "setup:env": "tsx scripts/setupEnv.ts",
    "chain": "hardhat node",
    "chain:slow": "cross-env SLOW_CHAIN=true hardhat node",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:localhost": "hardhat run scripts/deploy.ts --network localhost",
    "typecheck": "tsc --noEmit",
    "build": "hardhat compile && tsc -p tsconfig.build.json",
    "clean": "hardhat clean",
    "deploy:ssafy": "hardhat run scripts/deploy.ts --network ssafy",
    "grant:localhost": "hardhat run scripts/grantRoles.ts --network localhost",
    "grant:ssafy": "hardhat run scripts/grantRoles.ts --network ssafy"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.1.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "hardhat": "^2.22.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
