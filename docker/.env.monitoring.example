# 모니터링 스택 시크릿. 복사해서 .env.monitoring 으로 쓰세요 (커밋되지 않습니다).
#
#   cp .env.monitoring.example .env.monitoring && chmod 600 .env.monitoring
#
# 스택 하나가 dev 와 prod 를 함께 감시합니다. 환경을 고르는 값은 없습니다 — 지표가
# 들어오는 환경이 곧 감시 대상입니다. 운영이 뜨면 아래 POSTGRES_PASSWORD_PROD 만 채우세요.

# Grafana 로그인. https://<도메인>/dashboard/ 에서 쓰는 계정입니다 — 기본값(admin/admin)으로 두지 마세요
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Grafana 가 링크·리다이렉트에 쓰는 도메인. 운영으로 옮기면 teacat.site 로 바꿉니다
GRAFANA_DOMAIN=teacat.site

# postgres-exporter 는 환경마다 하나입니다 (DB 비밀번호가 다르기 때문)
POSTGRES_DB=teacat
POSTGRES_USER=teacat
# .env.dev 의 POSTGRES_PASSWORD 와 같은 값
POSTGRES_PASSWORD_DEV=
# 운영이 뜨면 .env.prod 의 POSTGRES_PASSWORD 와 같은 값을 채웁니다.
# 채워져 있으면 Jenkins 가 prod 쪽 exporter(compose profile "prod")를 함께 올립니다.
#POSTGRES_PASSWORD_PROD=
