# 모니터링 스택 시크릿. 복사해서 .env.monitoring 으로 쓰세요 (커밋되지 않습니다).
#
#   cp .env.monitoring.example .env.monitoring

# Grafana 로그인. 기본값(admin/admin)으로 두지 마세요
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# postgres-exporter 가 붙을 계정. .env.prod 의 값과 같아야 합니다
POSTGRES_DB=teacat
POSTGRES_USER=teacat
POSTGRES_PASSWORD=
