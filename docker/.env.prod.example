# docker-compose.prod.yml 이 읽는 값. EC2 에서는 ~/teacat/.env.prod 로 두고 커밋하지 않는다.
#   cp .env.prod.example .env.prod
#
# 🔴 개발(.env.dev)과 **모든 값을 다르게** 만드세요.
#    JWT_SECRET 이 같으면 개발에서 발급한 토큰이 운영에서도 통하고,
#    MASTER_MNEMONIC 이 같으면 두 환경이 같은 유저 지갑을 씁니다.
#
# 비밀번호 만들기:  openssl rand -base64 24
#   🔴 POSTGRES_PASSWORD 는 볼륨을 처음 만들 때 한 번만 적용된다. 처음에 확정할 것.

POSTGRES_DB=teacat
POSTGRES_USER=teacat
POSTGRES_PASSWORD=
REDIS_PASSWORD=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# 버킷은 서버가 없으면 만든다. 기본값 그대로 둬도 된다.
MINIO_BUCKET=teacat

# 32바이트 이상.  openssl rand -base64 48
JWT_SECRET=

# SSAFY 계정 로그인. 없으면 그 기능만 안 되고 나머지는 뜬다.
#   콜백 주소는 compose 파일에 https://teacat.site/api/auth/oauth/ssafy/callback 로 박혀 있다.
#   SSAFY 개발자센터에 **이 주소를 등록**해야 로그인이 끝까지 진행된다.
SSAFY_CLIENT_SECRET=

# ── 결제 (토스페이먼츠) ────────────────────────────────
# 🔴 비어 있으면 컨테이너가 뜨지 않는다 (compose 의 :? 가드).
#    일부러 그렇게 했다 — 키가 없어도 서버는 멀쩡히 뜨고 결제만 PAYMENT_001 로 거절돼서,
#    운영에서는 "배포는 초록인데 아무도 결제를 못 하는" 상태를 나중에야 알게 된다.
# 🔴 개발과 다른 키다. 개발은 test_ , 운영은 live_ 로 시작한다.
#    프론트가 쓰는 건 공개값인 클라이언트 키이고, 이 시크릿 키는 절대 내려보내지 않는다.
TOSS_SECRET_KEY=

# ── 포토카드 IPFS (Pinata) ─────────────────────────────
# 🔴 둘 다 비어 있으면 컨테이너가 뜨지 않는다 (compose 의 :? 가드).
#    빠뜨리면 도안 생성만 IPFS_001 로 막히고 나머지는 정상이라, 어드민이 도안을
#    만들려 할 때 처음 드러난다. 그래서 기동 단계에서 막는다.
# 🔴 CID 는 영원히 남지만 데이터는 누군가 핀하고 있어야 남는다. 이 계정이 만료되면
#    이미 발행된 카드의 그림이 지갑에서 깨진다 (blockchain/PHOTOCARD_PLAN.md 3장).
#    운영 카드가 걸린 계정이므로 개발과 계정을 나누거나, 최소한 만료를 관리할 것.
PINATA_JWT=
# 대시보드 Gateways 의 전용 주소. 공용 게이트웨이(gateway.pinata.cloud)는 25KB 이미지에
# 25초 타임아웃이 실측됐다. 체인에 올라가는 값은 ipfs://<cid> 라 이 주소를 바꿔도 온체인 값은 그대로다.
#   예: https://<이름>.mypinata.cloud
PINATA_GATEWAY_URL=

# ── 어드민 시드 계정 ───────────────────────────────────
# 관리자가 0명이면 대시보드에 들어갈 방법이 없어서, 서버가 뜰 때 하나 만든다 (멱등 — 이미
# ADMIN 이 있으면 아무것도 하지 않는다).
# 🔴 비밀번호가 비어 있으면 컨테이너가 뜨지 않는다 (compose 의 :? 가드).
#    application.yaml 의 기본값(6789)이 저장소에 적혀 있어, 그대로 나가면
#    저장소를 볼 수 있는 누구나 운영 어드민이 된다.
ADMIN_SEED_PASSWORD=
#ADMIN_SEED_EMAIL=admin@teacat.site
# 어드민을 이미 만들어 뒀으면 꺼도 된다. 꺼도 위 비밀번호 줄은 채워 둬야 한다
# (compose 는 profile·조건과 무관하게 값을 먼저 보간한다).
#ADMIN_SEED_ENABLED=true

# ── 배포 마커 (어드민 통계 차트) ────────────────────────
# 젠킨스가 배포 성공 후 POST /internal/deployments 에 이 키로 붙는다
# (Jenkinsfile 의 recordDeployment, 자격증명 ID: teacat-analytics-key).
# 🔴 젠킨스에 등록한 값과 **같아야** 한다. 다르면 마커만 401 로 빠진다 — 배포는 그대로 성공하고
#    차트의 세로선만 안 생기므로, 틀려도 한참 모른다.
# 비워 두면 그 엔드포인트는 전부 401 이다 (의도된 동작 — 키 없는 열린 API 를 만들지 않는다).
ANALYTICS_INTERNAL_API_KEY=

# ── 에러 리포팅 (Sentry) ───────────────────────────────
# 비어 있으면 그냥 안 켜진다. 나머지 기능에는 영향이 없다.
# 🔴 프론트 DSN 과 **다른 값**이다 — Sentry 프로젝트가 따로다 (플랫폼: Spring Boot).
SENTRY_DSN=
# 어느 배포에서 난 에러인지. 젠킨스가 커밋 해시로 덮어쓰므로 보통 비워 둔다
# (compose 기본값: teacat-server@prod).
#SENTRY_RELEASE=

# ── 블록체인 ──────────────────────────────────────────
#
# 🔴🔴 먼저 읽으세요 — 개발과 운영이 **같은 체인의 같은 컨트랙트**를 씁니다.
#
#   CatMoney 는 chain 31221 에 한 번만 배포돼 있고(contracts/deployments/ssafy.json)
#   그 주소가 이미지에 구워져 나갑니다. 개발 스택과 운영 스택이 이걸 함께 봅니다.
#
#   그래서 mint 멱등키가 충돌합니다. 시드 발행 키는 WALLET_SEED:{파생인덱스} 이고,
#   CatMoney 의 실행 기록은 **전역**입니다 (받는 사람이 달라도 같은 키는 한 번만 발행).
#   파생인덱스는 각 환경의 Postgres 시퀀스라 양쪽 다 1 부터 시작합니다.
#   → 개발에서 이미 쓴 인덱스 구간은 운영 가입자가 캣머니를 **0 받고** 지나갑니다
#     (응답은 ALREADY_DONE 이라 에러도 안 납니다 — 아무도 모르게 넘어갑니다).
#
#   운영을 열기 전에 셋 중 하나를 반드시 처리하세요:
#     1) 운영 DB 의 파생인덱스 시퀀스를 개발과 겹치지 않게 옮긴다 (코드 변경 없음)
#          ALTER SEQUENCE wallet_derivation_index_seq RESTART WITH 1000000;
#          (마이그레이션 V20260903_1604 에서 만든 시퀀스입니다)
#     2) 시드 멱등키에 환경 이름을 넣는다 (WALLET_SEED:prod:5) — 근본 해결
#     3) 운영용 CatMoney 를 따로 배포한다 — 완전 분리, 손이 가장 많이 간다

CHAIN_ID=31221
RPC_URL=https://rpc.ssafy-blockchain.com

# 🔴 유저 지갑을 파생하는 마스터 키. 바뀌면 전 유저의 지갑 주소가 바뀐다. 한 번 정하면 고정.
#    개발과 **다른 값**으로 만드세요. 같으면 개발 유저 #5 와 운영 유저 #5 가
#    같은 주소를 써서 잔액을 공유합니다.
MASTER_MNEMONIC=

# 🔴 0x + 64자리 hex. 가스 지불 지갑이면서 mint 를 부르는 키.
#
#    ⚠️ 새로 만들면 안 됩니다. CatMoney.mint 는 MINTER_ROLE 만 부를 수 있고,
#       배포 스크립트가 MINTER_ROLE 을 **배포자 주소에만** 줬습니다
#       (contracts/scripts/deploy.ts, 배포자 0xaeac79d8...).
#       새 키를 넣으면 가입 때 mint 가 revert 되고 가입이 통째로 롤백됩니다.
#
#    → 개발과 같은 오퍼레이터 키를 쓰거나, admin 키로 새 주소에
#      MINTER_ROLE 을 먼저 부여하세요.
#
#    🔴 잔액(가스)이 있어야 한다. 비면 회원가입이 전부 실패한다.
OPERATOR_PRIVATE_KEY=

# server <-> blockchain 내부 인증. 16자 이상.
#   한 값을 양쪽이 함께 쓴다 — 여기 한 줄이면 된다.
#   개발과 다른 값으로 만드세요.
INTERNAL_API_KEY=

# ── 포토카드 도안·추첨 (없으면 그 기능만 조용히 죽는다) ──────────
# 컨트랙트 OPERATOR_ROLE 로 서명하는 키. 도안 등록·정지·추첨에 쓴다.
# 추첨 공개는 블록해시 256개(약 42분) 안에 끝내야 해서 사람이 수동으로 못 한다.
# 🔴 0x + 64자리 hex. OPERATOR_PRIVATE_KEY 와 같은 키인지 블록체인 담당에게 확인할 것.
CONTRACT_OPERATOR_PRIVATE_KEY=

# 추첨 시드를 파생하는 비밀. 32자 이상.  openssl rand -hex 32
# 🔴 새면 리빌 전에 결과를 미리 아는 사람이 생긴다. 니모닉과 같은 급으로 다룰 것.
# 🔴 바꾸면 이미 커밋된 추첨의 시드가 달라져 리빌이 깨진다. 한 번 정하면 고정.
DRAW_SEED_SECRET=
