# blockchain 컨테이너만 읽는다. server 에는 넘어가지 않는다.
#
# 🔴 니모닉이 새면 전 유저의 지갑이 털린다. 이 프로세스 밖으로 내보내지 않는 것이
#    설계의 전제다 (blockchain/DESIGN.md 5-1).
#
#   cp .env.dev.chain.example .env.dev.chain && chmod 600 .env.dev.chain

# BIP-39 니모닉 12~24 단어.
# 🔴 바꾸면 전 유저의 지갑 주소가 바뀐다. 한 번 정하면 고정.
#    팀에서 쓰는 값을 받아 넣을 것. 직접 만들지 말 것.
MASTER_MNEMONIC=

# 0x + 64자리 hex. 팀이 공유하는 오퍼레이터 키.
# 배포한 계정이 컨트랙트 admin 이라, 다른 키를 쓰면 admin 함수를 못 쓴다.
OPERATOR_PRIVATE_KEY=

# ── 포토카드 도안·추첨 (없으면 그 기능만 조용히 죽는다) ──────────
# 컨트랙트 OPERATOR_ROLE 로 서명하는 키. 도안 등록·정지·추첨에 쓴다.
# 추첨 공개는 블록해시 256개(약 42분) 안에 끝내야 해서 사람이 수동으로 못 한다.
# 🔴 0x + 64자리 hex. OPERATOR_PRIVATE_KEY 와 같은 키인지 블록체인 담당에게 확인할 것.
CONTRACT_OPERATOR_PRIVATE_KEY=

# 추첨 시드를 파생하는 비밀. 32자 이상.  openssl rand -hex 32
# 🔴 새면 리빌 전에 결과를 미리 아는 사람이 생긴다. 니모닉과 같은 급으로 다룰 것.
# 🔴 바꾸면 이미 커밋된 추첨의 시드가 달라져 리빌이 깨진다. 한 번 정하면 고정.
DRAW_SEED_SECRET=
