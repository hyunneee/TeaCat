# docker-compose.dev.yml 이 읽는 값. EC2 에서는 ~/teacat/.env.dev 로 두고 커밋하지 않는다.
#   cp .env.dev.example .env.dev
#
# 비밀번호 만들기:  openssl rand -base64 24
#   🔴 POSTGRES_PASSWORD 는 볼륨을 처음 만들 때 한 번만 적용된다. 처음에 확정할 것.

POSTGRES_DB=teacat
POSTGRES_USER=teacat
POSTGRES_PASSWORD=
REDIS_PASSWORD=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# 32바이트 이상.  openssl rand -base64 48
JWT_SECRET=

# SSAFY 계정 로그인. 없으면 그 기능만 안 되고 나머지는 뜬다.
SSAFY_CLIENT_SECRET=

# ── 블록체인 ──────────────────────────────────────────
CHAIN_ID=31221
RPC_URL=https://rpc.ssafy-blockchain.com

# 🔴 유저 지갑을 파생하는 마스터 키. 바뀌면 전 유저의 지갑 주소가 바뀐다.
#    한 번 정하면 고정. 로컬 blockchain/.env 값을 그대로 쓰지 말고 배포용으로 새로 만들 것.
MASTER_MNEMONIC=

# 🔴 0x + 64자리 hex. 팀이 공유하는 오퍼레이터 키 (컨트랙트 admin)
OPERATOR_PRIVATE_KEY=

# server ↔ blockchain 내부 인증. 16자 이상.
#   한 값을 양쪽이 함께 쓴다 — 여기 한 줄이면 된다.
INTERNAL_API_KEY=
