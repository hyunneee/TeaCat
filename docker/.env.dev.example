# server 컨테이너가 env_file 로 통째로 읽는다.
# 그래서 여기 적는 이름은 **스프링이 읽는 이름 그대로**여야 한다
# (application.yaml 의 ${...} 안에 있는 이름).
#
# EC2 에서는 ~/teacat/.env.dev 로 두고 커밋하지 않는다.
#   cp .env.dev.example .env.dev && chmod 600 .env.dev
#
# 비밀번호:  openssl rand -base64 24      JWT:  openssl rand -base64 48
# 🔴 POSTGRES_PASSWORD 는 볼륨을 처음 만들 때 한 번만 적용된다. 처음에 확정할 것.

# ── 인프라 계정 ────────────────────────────────────────
POSTGRES_DB=teacat
POSTGRES_USER=teacat
POSTGRES_PASSWORD=
REDIS_PASSWORD=

MINIO_ROOT_USER=teacatadmin
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=teacat

# ── 서버 설정 ─────────────────────────────────────────
# 32바이트 이상
JWT_SECRET=

# 🔴 아래 셋은 여기서 고쳐도 안 먹는다. compose 의 environment: 가 같은 이름을 다시 넣는데,
#    environment: 가 env_file 보다 우선한다. 주소를 바꾸려면 docker-compose.dev.yml 을 고칠 것.
#    값을 남겨 두는 건 "지금 무엇으로 뜨는지" 를 여기서 같이 읽기 위해서다.
#      FRONTEND_BASE_URL=https://dev.teacat.site
#      REFRESH_COOKIE_SECURE=true
#      SSAFY_REDIRECT_URI=https://dev.teacat.site/api/auth/oauth/ssafy/callback

# SSAFY 계정 로그인. 비워두면 그 기능만 안 되고 나머지는 뜬다.
SSAFY_CLIENT_SECRET=

# ── server ↔ blockchain 공유 ──────────────────────────
# 한 곳에만 적는다. 양쪽 값이 갈라지면 가입이 401 로 실패한다.
INTERNAL_API_KEY=
CHAIN_ID=31221
RPC_URL=https://rpc.ssafy-blockchain.com

# ── 결제 (토스페이먼츠) ────────────────────────────────
# 비어 있으면 결제만 PAYMENT_001 로 거절되고 나머지는 그대로 뜬다.
# 개발은 test_ 로 시작하는 테스트 키를 쓴다 (운영은 live_ — 절대 섞지 말 것).
TOSS_SECRET_KEY=

# ── 포토카드 IPFS (Pinata) ─────────────────────────────
# 비어 있으면 도안 생성만 IPFS_001 로 막히고 나머지는 그대로 뜬다.
#   (운영은 이 둘이 비면 아예 기동을 막는다 — .env.prod.example 참고)
PINATA_JWT=
# 대시보드 Gateways 의 전용 주소. 공용 게이트웨이는 25KB 이미지에 25초 타임아웃이 실측됐다.
#   예: https://<이름>.mypinata.cloud   (비우면 gateway.pinata.cloud 로 붙는다)
PINATA_GATEWAY_URL=

# ── 어드민 시드 계정 ───────────────────────────────────
# 관리자가 0명이면 대시보드에 들어갈 방법이 없어서 서버가 뜰 때 하나 만든다 (멱등).
# 개발은 기본값(admin@teacat.site / 6789)으로 둬도 되지만, dev.teacat.site 는
# 인터넷에 열려 있으므로 바꿔 두는 쪽을 권한다.
#ADMIN_SEED_PASSWORD=
#ADMIN_SEED_ENABLED=true

# ── 배포 마커 (어드민 통계 차트) ────────────────────────
# 젠킨스는 운영(master) 배포에서만 마커를 보낸다. 개발에서는 안 쓰지만, 비워 두면
# POST /internal/deployments 가 401 이라 로컬에서 그 API 를 찔러볼 수 없다.
#ANALYTICS_INTERNAL_API_KEY=

# ── 에러 리포팅 (Sentry) ───────────────────────────────
# 비어 있으면 그냥 안 켜진다.
# 🔴 프론트 DSN 과 **다른 값**이다 — Sentry 프로젝트가 따로다 (플랫폼: Spring Boot).
SENTRY_DSN=
# 젠킨스가 커밋 해시로 덮어쓰므로 보통 비워 둔다 (compose 기본값: teacat-server@dev).
#SENTRY_RELEASE=
