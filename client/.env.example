# ─────────────────────────────────────────────────────────────
# 이 파일은 "어떤 키가 필요한지" 알려주는 템플릿입니다. (git 에 커밋됨)
# 실제 값은 .env.development / .env.production 에 넣으세요.
# VITE_ 접두사가 붙은 값은 번들에 그대로 박혀서 브라우저에 노출됩니다.
#   → 절대로 시크릿 키, DB 비번, 결제 secret 을 넣지 마세요.
# ─────────────────────────────────────────────────────────────

# 앱 표시용
VITE_APP_ENV=development
VITE_APP_NAME=티캣
# 앱 버전 — 설정 > 앱 정보에 표시되고, 서버가 알려주는 최신 버전과 비교합니다.
#   배포할 때 package.json 의 version 과 함께 올려주세요.
VITE_APP_VERSION=0.1.0

# API
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=/ws

# vite dev server 프록시가 실제로 찔러줄 백엔드 주소 (개발 전용)
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_WS_PROXY_TARGET=ws://localhost:8080

# 기능 플래그 — 배포 정책이 개발과 다른 것들
# 배포 시 1인 최대 1매로 제한하기로 한 규칙
VITE_MAX_TICKETS_PER_USER=1
# 개발용 목업/디버그 패널 노출 여부
VITE_ENABLE_DEVTOOLS=true

# 목업 데이터 사용 여부 (백엔드 완성 전 임시)
# true 면 src/mocks 의 가짜 응답을 봅니다. 운영 빌드에서는 반드시 false.
VITE_USE_MOCK=true

# ─── 결제 (토스페이먼츠) ───────────────────────────────────
# auto  = 아래 클라이언트 키가 채워져 있으면 실제 결제창, 비어 있으면 모의 결제
# toss  = 항상 실제 결제창 (키가 없으면 에러)
# mock  = 항상 모의 결제 (확인 창)
VITE_PAYMENT_MODE=auto

# 토스페이먼츠 클라이언트 키 (test_ck_... / live_ck_...)
# 개발자센터 > 내 개발정보 에서 복사하세요. 브라우저에 노출되는 공개 키입니다.
# ⚠️ 승인에 쓰는 시크릿 키(test_sk_...)는 절대 여기 넣지 마세요 — 백엔드 전용입니다.
# 토스페이먼츠 — 문서용 공개 테스트 클라이언트 키 (가입 없이 테스트 가능)
# ⚠️ 시크릿 키(test_gsk_...)는 절대 여기 넣지 마세요. VITE_ 값은 번들에 그대로 박혀
#    브라우저에서 누구나 읽을 수 있습니다. 승인용 시크릿 키는 백엔드 환경변수로.
VITE_TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm

# ─── 에러 리포팅 (Sentry) ──────────────────────────────────
# 비워 두면 Sentry 를 **아예 켜지 않습니다.** 로컬에서 굳이 채울 필요 없습니다.
# DSN 은 번들에 박히는 공개 값입니다 (이벤트를 보내는 주소일 뿐, 대시보드 접근 권한이 아님).
# ⚠️ 소스맵 업로드용 SENTRY_AUTH_TOKEN 은 전혀 다른 물건입니다. 절대 VITE_ 로 두지 마세요.
VITE_SENTRY_DSN=

# 성능 추적 표본율 (0~1). 에러는 이 값과 무관하게 전부 올라갑니다.
# 비워 두면 개발 1, 운영 0.1. 티켓 오픈 때 무료 할당량이 몇 분 만에 타는 걸 막습니다.
VITE_SENTRY_TRACES_SAMPLE_RATE=

# dev/prod 를 가르는 태그. 비우면 vite 모드(development/production)를 씁니다.
# 🔴 배포에서는 이 파일 값이 아니라 CI 가 넘기는 --build-arg 를 씁니다 —
#    dev 배포도 --mode production 으로 빌드해서, 안 넘기면 dev 에러가 production 으로 찍힙니다.
VITE_SENTRY_ENVIRONMENT=
# 어느 커밋에서 난 에러인지. CI 가 teacat-client@<커밋해시> 를 넣습니다.
# 🔴 소스맵을 올리는 release 이름과 **글자까지 같아야** 짝이 맞습니다 (vite.config.ts).
VITE_SENTRY_RELEASE=

# ─── 소스맵 업로드 (Sentry) — 여기부터는 VITE_ 가 아닙니다 ────
# 🔴 아래 세 값에 VITE_ 를 붙이지 마세요. 붙이는 순간 번들에 박혀 토큰이 공개됩니다.
#    이 파일(.env.*)에 적어도 vite 가 읽지 않습니다 — VITE_ 접두사만 로드하기 때문입니다.
#    빌드 프로세스의 **환경변수**로만 전달됩니다 (client/Dockerfile · Jenkinsfile).
#
#   SENTRY_ORG          vitamin7  (공개 값. Dockerfile 에 기본값으로 박혀 있음)
#   SENTRY_PROJECT      teacat    (공개 값. 서버 프로젝트 teacat-spring-boot 와 다름)
#   SENTRY_AUTH_TOKEN   🔴 시크릿. 서버의 ~/teacat/.sentry-auth-token 에만 둡니다.
#                       Sentry > Settings > Auth Tokens 에서 project:releases + org:read
#                       범위로 발급합니다. DSN 과 전혀 다른 물건입니다.
#
# 셋 다 채워졌을 때만 소스맵을 만들고, 올린 뒤 dist 에서 지웁니다.
# 비어 있으면 소스맵을 만들지도 않습니다 — 로컬 빌드는 신경 쓸 필요 없습니다.

# ── 얼굴 등록 (브라우저에서만 사용) ──
# 모델 파일은 public/models/ 에 두거나 CDN 주소를 넣으세요. public/models/README.md 참고
VITE_FACE_DETECTOR_URL=/models/face_detection_yunet_2023mar.onnx
VITE_FACE_EMBEDDER_URL=/models/face_recognition_sface_2021dec_int8.onnx
VITE_FACE_MODEL_VERSION=yunet2023mar+sface2021dec-int8@1

# ─── 행동 분석 (Microsoft Clarity) ─────────────────────────
# 비워 두면 Clarity 를 **아예 켜지 않습니다.** 로컬에서 굳이 채우지 마세요 —
# 내 개발 세션이 히트맵에 섞이면 지표를 못 씁니다.
# 프로젝트 ID 는 스크립트 주소에 실리는 공개 값입니다 (대시보드 접근 권한이 아님).
# ⚠️ 데이터 내보내기용 API 토큰은 전혀 다른 물건입니다. 절대 VITE_ 로 두지 마세요.
#
# 🔴 Clarity 에는 Sentry 의 environment 같은 태그가 없습니다.
#    dev/prod 는 **프로젝트를 따로 만들어** 서로 다른 ID 를 넘깁니다.
#    같은 ID 를 쓰면 두 환경의 히트맵이 섞여서 분간이 안 됩니다.
#
# 🔴 켜기 전에 대시보드에서 **설정 > 마스킹 > Strict** 로 바꿔야 합니다.
#    기본값 Balanced 는 숫자·이메일만 가립니다. 마스킹 변경은 소급 적용이 안 됩니다.
VITE_CLARITY_PROJECT_ID=

# ─── 이용 분석 (Google Analytics 4) ────────────────────────
# 비어 있으면 GA 를 아예 켜지 않습니다 (스크립트도 받지 않음). 기본값은 꺼짐입니다.
# 측정 ID(G-...) 는 스크립트 주소에 실리는 공개 값입니다 (리포트 접근 권한이 아님).
# ⚠️ Data API 용 서비스 계정 키는 전혀 다른 물건입니다. 절대 VITE_ 로 두지 마세요.
#
# 🔴 GA4 에도 Sentry 의 environment 같은 태그가 없습니다.
#    dev/prod 는 **속성을 따로 만들어** 서로 다른 측정 ID 를 넘깁니다.
#    같은 ID 를 쓰면 개발 중 클릭이 운영 지표에 그대로 섞입니다.
#
# 🔴 켜기 전에 GA 콘솔에서 **관리 > 데이터 스트림 > 향상된 측정 >
#    페이지 조회수 > "브라우저 기록 이벤트 기반 페이지 변경" 을 꺼야 합니다.**
#    우리가 라우트마다 직접 보내므로, 켜 두면 모든 화면 이동이 두 번 집계됩니다.
VITE_GA_MEASUREMENT_ID=
