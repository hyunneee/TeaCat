VITE_APP_ENV=production
VITE_APP_NAME=티캣
# 앱 버전 — 설정 > 앱 정보에 표시되고, 서버가 알려주는 최신 버전과 비교합니다.
#   배포할 때 package.json 의 version 과 함께 올려주세요.
VITE_APP_VERSION=0.1.0

# 배포 도메인 확정되면 교체하세요. (동일 도메인이면 /api 유지)
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=/ws

# 운영 배포 정책: 1인 1매
VITE_MAX_TICKETS_PER_USER=1
VITE_ENABLE_DEVTOOLS=false

# ⚠️ 목업은 이제 **일부 도메인만** 잡습니다 (client/src/mocks/index.ts).
#    회원가입·로그인·내 정보·얼굴 등록·공연 조회는 true 여도 실서버로 나갑니다.
#    아직 서버에 컨트롤러가 없는 것만 목업이 받습니다 —
#      /banners, /app/version, /schedules/*/seats, /schedules/*/sections, /holds/*,
#      /me/tickets, /me/nfts, /me/resale, /nfts, /payments/*, /resale/*, /auth/captcha
#    그래서 false 로 바꾸면 홈 화면(배너)부터 빕니다. 위 API 가 다 붙은 뒤에 끄세요.
#
# ⚠️ 배포 빌드는 이 값이 아니라 CI 가 넘기는 --build-arg VITE_USE_MOCK 을 씁니다
#    (client/Dockerfile · Jenkinsfile). 여기 값은 로컬 `vite build` 용 기본값입니다.
VITE_USE_MOCK=true

# ─── 결제 (토스페이먼츠) ───────────────────────────────────
# auto  = 아래 클라이언트 키가 채워져 있으면 실제 결제창, 비어 있으면 모의 결제
# toss  = 항상 실제 결제창 (키가 없으면 에러)
# mock  = 항상 모의 결제 (확인 창)
VITE_PAYMENT_MODE=auto

# 토스페이먼츠 클라이언트 키 (test_ck_... / live_ck_...)
# 개발자센터 > 내 개발정보 에서 복사하세요. 브라우저에 노출되는 공개 키입니다.
# ⚠️ 승인에 쓰는 시크릿 키(test_sk_...)는 절대 여기 넣지 마세요 — 백엔드 전용입니다.
# 토스페이먼츠 — 문서용 공개 테스트 클라이언트 키 (가입 없이 테스트 가능)
# ⚠️ 시크릿 키(test_gsk_...)는 절대 여기 넣지 마세요. VITE_ 값은 번들에 그대로 박혀
#    브라우저에서 누구나 읽을 수 있습니다. 승인용 시크릿 키는 백엔드 환경변수로.
VITE_TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm

# ─── 에러 리포팅 (Sentry) ──────────────────────────────────
# DSN 은 브라우저에 노출되는 공개 값입니다. environment 태그로 dev/prod 를 구분합니다.
# ⚠️ Sentry 프로젝트 설정 > Client Security 의 Allowed Domains 에 배포 도메인을 넣어 두세요.
#    안 넣으면 누가 이 DSN 으로 아무 데서나 이벤트를 쏴서 할당량을 태울 수 있습니다.
VITE_SENTRY_DSN=https://8c66e974c1f88a4a34b4b6364f5927ba@o4510400151027712.ingest.us.sentry.io/4512059819556864

# 운영은 10%만 성능 추적. 에러는 표본과 무관하게 전부 올라갑니다.
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ── 얼굴 등록 (브라우저에서만 사용) ──
# 모델 파일은 public/models/ 에 두거나 CDN 주소를 넣으세요. public/models/README.md 참고
VITE_FACE_DETECTOR_URL=/models/face_detection_yunet_2023mar.onnx
VITE_FACE_EMBEDDER_URL=/models/face_recognition_sface_2021dec_int8.onnx
VITE_FACE_MODEL_VERSION=yunet2023mar+sface2021dec-int8@1

# ─── 행동 분석 (Microsoft Clarity) ─────────────────────────
# ⚠️ 배포 빌드는 이 값이 아니라 CI 가 넘기는 --build-arg VITE_CLARITY_PROJECT_ID 를 씁니다
#    (client/Dockerfile · Jenkinsfile). 여기 값은 로컬 `vite build` 용 기본값입니다.
# 🔴 dev 와 prod 는 **프로젝트를 따로** 만들어 서로 다른 ID 를 넘깁니다 —
#    Clarity 에는 Sentry 의 environment 같은 태그가 없어서 같은 ID 면 히트맵이 섞입니다.
# 🔴 켜기 전에 대시보드 설정 > 마스킹 > Strict. 기본값 Balanced 로 켜면
#    그 사이 올라간 세션은 가려지지 않은 채로 남습니다 (마스킹은 소급 적용 안 됨).
VITE_CLARITY_PROJECT_ID=

# ─── 이용 분석 (Google Analytics 4) ────────────────────────
# ⚠️ 배포 빌드는 이 값이 아니라 CI 가 넘기는 --build-arg VITE_GA_MEASUREMENT_ID 를 씁니다
#    (client/Dockerfile · Jenkinsfile). 여기 값은 로컬 `vite build` 용 기본값이라 비워 둡니다 —
#    로컬 빌드를 미리보기(npm run preview)로 열어 볼 때 운영 지표가 오염되지 않게.
# 🔴 dev 와 prod 는 **속성을 따로** 만들어 서로 다른 측정 ID 를 넘깁니다 —
#    GA4 에도 environment 태그가 없어서 같은 ID 면 개발 클릭이 운영 지표에 섞입니다.
VITE_GA_MEASUREMENT_ID=
