VITE_APP_ENV=development
VITE_APP_NAME=티캣 (DEV)
# 앱 버전 — 설정 > 앱 정보에 표시되고, 서버가 알려주는 최신 버전과 비교합니다.
#   배포할 때 package.json 의 version 과 함께 올려주세요.
VITE_APP_VERSION=0.1.0

VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=/ws

VITE_API_PROXY_TARGET=http://localhost:8080
VITE_WS_PROXY_TARGET=ws://localhost:8080

VITE_MAX_TICKETS_PER_USER=1
VITE_ENABLE_DEVTOOLS=true

# 목업은 **일부 도메인만** 잡습니다 (client/src/mocks/index.ts).
# 회원가입·로그인·내 정보·얼굴 등록·공연 조회는 true 여도 실서버(/api 프록시)로 나갑니다.
VITE_USE_MOCK=true

# ─── 결제 (토스페이먼츠) ───────────────────────────────────
# auto  = 아래 클라이언트 키가 채워져 있으면 실제 결제창, 비어 있으면 모의 결제
# toss  = 항상 실제 결제창 (키가 없으면 에러)
# mock  = 항상 모의 결제 (확인 창)
VITE_PAYMENT_MODE=auto

# 토스페이먼츠 클라이언트 키 (test_ck_... / live_ck_...)
# 개발자센터 > 내 개발정보 에서 복사하세요. 브라우저에 노출되는 공개 키입니다.
# ⚠️ 승인에 쓰는 시크릿 키(test_sk_...)는 절대 여기 넣지 마세요 — 백엔드 전용입니다.
# 토스페이먼츠 — 문서용 공개 테스트 클라이언트 키 (가입 없이 테스트 가능)
# ⚠️ 시크릿 키(test_gsk_...)는 절대 여기 넣지 마세요. VITE_ 값은 번들에 그대로 박혀
#    브라우저에서 누구나 읽을 수 있습니다. 승인용 시크릿 키는 백엔드 환경변수로.
VITE_TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm

# ─── 에러 리포팅 (Sentry) ──────────────────────────────────
# 비워 두면 꺼집니다. 내 노트북 에러를 대시보드에 올리기 싫으면 값을 지우세요.
VITE_SENTRY_DSN=https://8c66e974c1f88a4a34b4b6364f5927ba@o4510400151027712.ingest.us.sentry.io/4512059819556864
VITE_SENTRY_TRACES_SAMPLE_RATE=1

# ── 얼굴 등록 (브라우저에서만 사용) ──
# 모델 파일은 public/models/ 에 두거나 CDN 주소를 넣으세요. public/models/README.md 참고
VITE_FACE_DETECTOR_URL=/models/face_detection_yunet_2023mar.onnx
VITE_FACE_EMBEDDER_URL=/models/face_recognition_sface_2021dec_int8.onnx
VITE_FACE_MODEL_VERSION=yunet2023mar+sface2021dec-int8@1

# ─── 행동 분석 (Microsoft Clarity) ─────────────────────────
# 🔴 **일부러 비워 둡니다. 여기에 ID 를 넣지 마세요.**
#    이 파일은 커밋되므로, 값을 넣으면 팀원 모두의 `npm run dev` 세션이 히트맵에 들어갑니다.
#    Sentry(DSN 을 이 파일에 넣어 둠)와 판단이 다른 이유:
#      - 에러는 하나씩 들여다보고 environment 태그로 걸러낼 수 있습니다.
#      - 히트맵·rage click 은 **여러 세션을 합친 값**이고 Clarity 에는 환경 태그가 없어서,
#        HMR·목업·devtools 가 낀 로컬 세션이 섞이면 지표 자체가 못 쓰게 됩니다.
#
#    배포된 dev(dev.teacat.site)는 CI 가 `--build-arg VITE_CLARITY_PROJECT_ID` 로 켭니다
#    (Jenkinsfile '빌드: 프론트'). 그래서 여기가 비어 있어도 dev 배포본은 동작합니다.
#
# 로컬에서 잠깐 켜서 확인하려면 이 파일이 아니라 **`.env.development.local`** 에 넣으세요.
# 그 파일은 `.gitignore` 에 있어서 커밋되지 않습니다.
#    echo "VITE_CLARITY_PROJECT_ID=yfz2y32jxa" > client/.env.development.local
# 확인이 끝나면 지우세요. 켜 둔 채로 개발하면 내 세션이 계속 쌓입니다.
VITE_CLARITY_PROJECT_ID=

# ─── 이용 분석 (Google Analytics 4) ────────────────────────
# 🔴 여기에 측정 ID 를 넣지 마세요. Clarity 와 **같은 이유**입니다 (위 항목 참고) —
#    이 파일은 커밋되므로 팀원 모두의 로컬 npm run dev 가 지표에 들어갑니다.
#    세션 수·이탈률·퍼널은 여러 세션을 합친 값이라, HMR 로 새로고침이 반복되는
#    로컬 세션이 섞이면 숫자 자체를 믿을 수 없게 됩니다.
#
#    지금은 운영(teacat.site) 속성 하나뿐이라 dev 배포도 꺼져 있습니다.
#    dev 를 켜려면 GA 에서 **속성을 하나 더 만들어** Jenkinsfile 의 GA_ID 에 채우세요.
#
# 로컬에서 잠깐 켜서 확인하려면 이 파일이 아니라 **`.env.development.local`** 에 넣으세요.
#    echo "VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX" > client/.env.development.local
# 확인이 끝나면 지우세요. 실시간 리포트로 붙었는지만 보고 끄면 됩니다.
VITE_GA_MEASUREMENT_ID=
