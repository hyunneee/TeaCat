# ─────────────────────────────────────────────────────────────
# 이 파일은 "어떤 값이 필요한지" 알려주는 템플릿입니다. (git 에 커밋됨)
#   cp .env.example .env  로 복사한 뒤 실제 값을 채우세요.
#   .env 는 커밋되지 않습니다.
#
# application.yaml 의 spring.config.import 가 이 파일을 읽어들이므로
# 여기에 적은 값이 ${...} 자리에 그대로 들어갑니다.
# ─────────────────────────────────────────────────────────────

# SSAFY 계정 로그인 — 어플리케이션 등록 시 발급받은 시크릿
# 🔴 이 값은 절대 커밋하거나 채팅·이슈에 붙여넣지 마세요.
SSAFY_CLIENT_SECRET=

# 아래는 기본값이 있어서 비워둬도 됩니다. 바꿀 때만 채우세요.
# SSAFY_CLIENT_ID=
# SSAFY_REDIRECT_URI=http://localhost:8080/api/auth/oauth/ssafy/callback

# JWT 서명 키 (최소 32바이트). 운영에서는 반드시 새로 만들어 넣습니다.
# JWT_SECRET=

# 리프레시 토큰 쿠키. 프론트와 도메인이 다른 환경에서는 None / true 여야 합니다.
# REFRESH_COOKIE_SAME_SITE=Lax
# REFRESH_COOKIE_SECURE=false

# 외부 로그인 후 사용자를 돌려보낼 프론트 주소
# FRONTEND_BASE_URL=http://localhost:5173

# 블록체인 서비스(Node.js) 연동
# 🔴 blockchain/.env 의 INTERNAL_API_KEY 와 **같은 값**을 넣어야 합니다. 틀리면 401 로 가입이 실패합니다.
BLOCKCHAIN_INTERNAL_API_KEY=

# 아래는 기본값이 있어서 비워둬도 됩니다.
#   BLOCKCHAIN_CHAIN_ID 는 blockchain/.env 의 CHAIN_ID 와 반드시 같아야 합니다.
# BLOCKCHAIN_API_URL=http://127.0.0.1:4000
# BLOCKCHAIN_CHAIN_ID=31221
