# ─────────────────────────────────────────────────────────────
# 이 파일은 "어떤 키가 필요한지" 알려주는 템플릿입니다. (git 에 커밋됨)
# 실제 값은 .env.development / .env.production 에 넣으세요.
# VITE_ 접두사가 붙은 값은 번들에 그대로 박혀서 브라우저에 노출됩니다.
#   → 절대로 시크릿 키, DB 비번, 결제 secret 을 넣지 마세요.
# ─────────────────────────────────────────────────────────────

# 앱 표시용
VITE_APP_ENV=development
VITE_APP_NAME=티캣
# 앱 버전 — 설정 > 앱 정보에 표시되고, 서버가 알려주는 최신 버전과 비교합니다.
#   배포할 때 package.json 의 version 과 함께 올려주세요.
VITE_APP_VERSION=0.1.0

# API
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=/ws

# vite dev server 프록시가 실제로 찔러줄 백엔드 주소 (개발 전용)
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_WS_PROXY_TARGET=ws://localhost:8080

# 기능 플래그 — 배포 정책이 개발과 다른 것들
# 배포 시 1인 최대 1매로 제한하기로 한 규칙
VITE_MAX_TICKETS_PER_USER=1
# 개발용 목업/디버그 패널 노출 여부
VITE_ENABLE_DEVTOOLS=true

# 목업 데이터 사용 여부 (백엔드 완성 전 임시)
# true 면 src/mocks 의 가짜 응답을 봅니다. 운영 빌드에서는 반드시 false.
VITE_USE_MOCK=true

# ─── 결제 (토스페이먼츠) ───────────────────────────────────
# auto  = 아래 클라이언트 키가 채워져 있으면 실제 결제창, 비어 있으면 모의 결제
# toss  = 항상 실제 결제창 (키가 없으면 에러)
# mock  = 항상 모의 결제 (확인 창)
VITE_PAYMENT_MODE=auto

# 토스페이먼츠 클라이언트 키 (test_ck_... / live_ck_...)
# 개발자센터 > 내 개발정보 에서 복사하세요. 브라우저에 노출되는 공개 키입니다.
# ⚠️ 승인에 쓰는 시크릿 키(test_sk_...)는 절대 여기 넣지 마세요 — 백엔드 전용입니다.
# 토스페이먼츠 — 문서용 공개 테스트 클라이언트 키 (가입 없이 테스트 가능)
# ⚠️ 시크릿 키(test_gsk_...)는 절대 여기 넣지 마세요. VITE_ 값은 번들에 그대로 박혀
#    브라우저에서 누구나 읽을 수 있습니다. 승인용 시크릿 키는 백엔드 환경변수로.
VITE_TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm

# ── 얼굴 등록 (브라우저에서만 사용) ──
# 모델 파일은 public/models/ 에 두거나 CDN 주소를 넣으세요. public/models/README.md 참고
VITE_FACE_DETECTOR_URL=/models/face_detection_yunet_2023mar.onnx
VITE_FACE_EMBEDDER_URL=/models/face_recognition_sface_2021dec_int8.onnx
VITE_FACE_MODEL_VERSION=yunet2023mar+sface2021dec-int8@1
