VITE_APP_ENV=production
VITE_APP_NAME=티캣

# 배포 도메인 확정되면 교체하세요. (동일 도메인이면 /api 유지)
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=/ws

# 운영 배포 정책: 1인 1매
VITE_MAX_TICKETS_PER_USER=1
VITE_ENABLE_DEVTOOLS=false

VITE_USE_MOCK=false

# 실 결제 연동 시 portone 으로 바꾸고 아래 두 값을 채우세요.
VITE_PAYMENT_MODE=mock
VITE_PORTONE_STORE_ID=
VITE_PORTONE_CHANNEL_KEY=
